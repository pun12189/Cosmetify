<Window x:Class="Cosmetify.Dialogs.OrderEditViewPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cosmetify.Dialogs"
 xmlns:control="http://metro.mahapps.com/winfx/xaml/controls"
   xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
   xmlns:conv="clr-namespace:Cosmetify.Helper"
   xmlns:System="clr-namespace:System;assembly=mscorlib"
   xmlns:enums="clr-namespace:Cosmetify.Model.Enums" 
        mc:Ignorable="d"
        Title="OrderEditViewPage" Height="800" Width="1000" WindowStartupLocation="CenterScreen" x:Name="odInv">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:InvertableBooleanToVisibilityConverter x:Key="InvertableBooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height=".3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition/>
                <!--1-->
                <RowDefinition Height="10"/>
                <RowDefinition/>
                <!--3-->
                <RowDefinition Height="10"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Select Customer" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbCust" Margin="0,0,5,0" VerticalAlignment="Center" IsEnabled="False" Width="150" DisplayMemberPath="FirstName" SelectedValuePath="Id" SelectionChanged="cbCust_SelectionChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Select Brand" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbBrand" Margin="0,0,5,0" IsEnabled="False" VerticalAlignment="Center" Width="150"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Vertical">
                <CheckBox Content="Custom" x:Name="chCust"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Select Product" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding ElementName=chCust, Path=IsChecked, Converter={StaticResource InvertableBooleanToVisibilityConverter}, ConverterParameter=Inverted}"/>
                    <ComboBox x:Name="cbProduct" Margin="0,0,5,0" VerticalAlignment="Center" Width="150" DisplayMemberPath="Code" SelectionChanged="cbProduct_SelectionChanged" Visibility="{Binding ElementName=chCust, Path=IsChecked, Converter={StaticResource InvertableBooleanToVisibilityConverter}, ConverterParameter=Inverted}"/>
                    <TextBlock Text="Product Name" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding ElementName=chCust, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox x:Name="tbPname" Margin="0,0,5,0" VerticalAlignment="Center" Width="150" Visibility="{Binding ElementName=chCust, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button x:Name="btnAddProd" Visibility="{Binding ElementName=chCust, Path=IsChecked, Converter={StaticResource InvertableBooleanToVisibilityConverter}, ConverterParameter=Inverted}" Background="Transparent" Click="btnAddProd_Click" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <icon:FontAwesome Kind="PlusCircleSolid"/>
                    </Button>
                </StackPanel>
                <TextBox x:Name="tbMProd" control:TextBoxHelper.Watermark="Enter Extra Info"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Color" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbColor" Margin="0,0,5,0" VerticalAlignment="Center" Width="150" DisplayMemberPath="Name"/>
                <Button x:Name="btnAddColor" Background="Transparent" Click="btnAddColor_Click" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Add New Customer">
                    <icon:FontAwesome Kind="PlusCircleSolid"/>
                </Button>
            </StackPanel>            
            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Claims" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBox x:Name="tbClaims" Width="200" VerticalAlignment="Center" control:TextBoxHelper.Watermark="Type Claims..."/>
            </StackPanel>            
        </Grid>
        <DataGrid Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" Margin="10" Name="dataGrid1" VerticalAlignment="Stretch" ItemsSource="{Binding ElementName=odInv, Path=BatchOrderCollection}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Actives.ActivesName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Actives.ShortCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                <DataGridTextColumn Header="%/pcs Required" Binding="{Binding PercentageRequired, UpdateSourceTrigger=LostFocus}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" x:Name="stkAct">
            <TextBlock Text="Add Item" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbProd" VerticalAlignment="Center" Width="200" DisplayMemberPath="ActivesName" Margin="0,0,5,0" SelectionChanged="cbProd_SelectionChanged"/>
            <Button x:Name="btnLoad" Background="Transparent" ToolTip="Select Categories to Load Items" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnLoad_Click">
                <icon:BootstrapIcons Kind="Download"/>
            </Button>
        </StackPanel>
        <DataGrid Grid.Row="6" ColumnWidth="Auto" SelectionMode="Extended" SelectionUnit="FullRow" ItemsSource="{Binding ElementName=odInv, Path=BatchModelCollection}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" HorizontalAlignment="Stretch" Margin="10" Name="dgBatch" VerticalAlignment="Stretch" SelectionChanged="dgBatch_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product ID" Binding="{Binding ProductID, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Brand Name" Binding="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn Header="Actives" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding BatchOrderCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Actives.ActivesName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PercentageRequired, StringFormat={}{0}%}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Color" Binding="{Binding Colour, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn Header="Claims" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Claims}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Background="Transparent" Click="DeleteBatch" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <icon:FontAwesome Kind="TrashSolid"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <Button x:Name="btnAddProduct" Content="Add Product" Grid.Row="8" Width="200" Margin="5" Click="btnAddProduct_Click"/>
            <Button x:Name="btnCreateOrder" Content="Update Order" Grid.Row="8" Width="200" Margin="5" Click="btnCreateOrder_Click"/>
        </StackPanel>
    </Grid>
</Window>
