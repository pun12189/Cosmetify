<Window x:Class="Cosmetify.Dialogs.ActivesViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cosmetify.Dialogs"
        mc:Ignorable="d"
        Title="Actives View" Height="200" Width="400" x:Name="activesView" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <DataGrid FontFamily="Arial" Foreground="Black" ItemsSource="{Binding ElementName=activesView, Path=ActivesModelsCollection}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HorizontalAlignment="Stretch" Margin="10" Name="dataGrid1" VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding ActivesName, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Code" Binding="{Binding ShortCode, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Brand Names" Binding="{Binding BrandNames, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Product Names" Binding="{Binding ProductNames, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
